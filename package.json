{
  "author": "drixev",
  "name": "agent-graph",
  "displayName": "Agent Graph",
  "description": "Visualize and navigate the code graph of your project — dependencies, calls, and structure — directly inside VS Code.",
  "version": "0.0.1",
  "publisher": "agent-graph",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drixev-tools/agent-graph"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentGraph.analyzeWorkspace",
        "title": "Project Graph: Analyze Workspace"
      },
      {
        "command": "agentGraph.openArchitecture",
        "title": "Project Graph: Open Architecture"
      },
      {
        "command": "agentGraph.calculateImpact",
        "title": "Project Graph: Calculate Impact"
      },
      {
        "command": "agentGraph.showSequenceDiagram",
        "title": "Show Sequence Diagram"
      },
      {
        "command": "agentGraph.designProject",
        "title": "Project Graph: Design Project"
      },
      {
        "command": "agentGraph.sidebar.refresh",
        "title": "Project Graph: Refresh Sidebar",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentGraph",
          "title": "Project Graph",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "agentGraph": [
        {
          "id": "agentGraph.explorer",
          "name": "Project Graph",
          "icon": "media/activity-bar-icon.svg"
        },
        {
          "id": "agentGraph.settings",
          "name": "AI Settings",
          "type": "webview",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "agentGraph.showSequenceDiagram",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentGraph.sidebar.refresh",
          "when": "view == agentGraph.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentGraph.showSequenceDiagram",
          "when": "view == agentGraph.explorer && (viewItem == agentGraph.node.function || viewItem == agentGraph.node.file)",
          "group": "1_agentGraph"
        }
      ]
    },
    "configuration": {
      "title": "Agent Graph",
      "properties": {
        "agentGraph.claudeModel": {
          "type": "string",
          "enum": [
            "claude-opus-5",
            "claude-sonnet-5",
            "claude-haiku-4-5"
          ],
          "enumDescriptions": [
            "Claude Opus 5 (most capable)",
            "Claude Sonnet 5 (balanced, default)",
            "Claude Haiku 4.5 (fastest)"
          ],
          "default": "claude-sonnet-5",
          "description": "Claude model Agent Graph uses for AI-powered features (Design Project, Impact, and Sequence Diagram views). The Anthropic API key itself is configured separately, in the AI Settings sidebar view, and is never stored in this setting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && node scripts/copy-python-server.js dist",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && node scripts/copy-python-server.js dist",
    "compile-tests": "tsc -p . --outDir out && node scripts/copy-python-server.js out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@xyflow/react": "^12.11.6",
    "dagre": "^0.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript-eslint": "^8.70.0"
  }
}
