{
  "author": "drixev",
  "name": "atlas-graph",
  "displayName": "Atlas Graph",
  "description": "Visualize and navigate the code graph of your project — dependencies, calls, and structure — directly inside VS Code.",
  "version": "0.1.0",
  "publisher": "drixev",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/drixev-tools/atlas"
  },
  "bugs": {
    "url": "https://github.com/drixev-tools/atlas/issues"
  },
  "homepage": "https://github.com/drixev-tools/atlas#readme",
  "engines": {
    "vscode": "^1.85.0"
  },  
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "architecture",
    "diagram",
    "dependency graph",
    "call graph",
    "sequence diagram",
    "code visualization",
    "typescript",
    "javascript",
    "python",
    "claude",
    "ai"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "atlas.analyzeWorkspace",
        "title": "Atlas: Analyze Workspace"
      },
      {
        "command": "atlas.openArchitecture",
        "title": "Atlas: Open Architecture"
      },
      {
        "command": "atlas.showSequenceDiagram",
        "title": "Atlas: Show Sequence Diagram"
      },
      {
        "command": "atlas.showActiveFileFlow",
        "title": "Atlas: Show Active File Flow"
      },
      {
        "command": "atlas.showIdentifiedArchitecture",
        "title": "Atlas: Show Identified Architecture (AI)"
      },
      {
        "command": "atlas.sidebar.refresh",
        "title": "Atlas: Refresh Sidebar",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atlas",
          "title": "Atlas",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "atlas": [
        {
          "id": "atlas.explorer",
          "name": "Atlas",
          "icon": "media/activity-bar-icon.svg"
        },
        {
          "id": "atlas.settings",
          "name": "AI Settings",
          "type": "webview",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "atlas.sidebar.refresh",
          "when": "view == atlas.explorer",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Atlas",
      "properties": {
        "atlas.claudeModel": {
          "type": "string",
          "enum": [
            "claude-opus-5",
            "claude-sonnet-5",
            "claude-haiku-4-5"
          ],
          "enumDescriptions": [
            "Claude Opus 5 (most capable)",
            "Claude Sonnet 5 (balanced, default)",
            "Claude Haiku 4.5 (fastest)"
          ],
          "default": "claude-sonnet-5",
          "description": "Claude model Atlas uses for AI-powered features (Sequence Diagram and Identified Architecture views). The Anthropic API key itself is configured separately, in the AI Settings sidebar view, and is never stored in this setting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && node scripts/copy-python-server.js dist",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:python": "node scripts/copy-python-server.js dist",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && node scripts/copy-python-server.js dist",
    "compile-tests": "tsc -p . --outDir out && node scripts/copy-python-server.js out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsci":"vsce package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@xyflow/react": "^12.11.6",
    "dagre": "^0.8.5",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript-eslint": "^8.70.0"
  }
}
